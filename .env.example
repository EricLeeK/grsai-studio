# Grsai Studio 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# [必填] Grsai API Key
GRSAI_API_KEY=your_api_key_here

# [必填] WeChat Official Account credentials
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# [必填] Gemini Markdown-to-WeChat converter
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# [可选] API 基础地址（默认国内节点）
# 海外：https://grsaiapi.com
# 国内：https://grsai.dakka.com.cn
# GRSAI_BASE_URL=https://grsai.dakka.com.cn

# [可选] 默认输出目录（默认 ~/Downloads）
# GRSAI_OUTPUT_DIR=./output
